# Copy to .env for local development. In production these are set via
# cPanel's "Setup Python App" environment-variable UI instead (see CLAUDE.md).

SECRET_KEY=change-me-to-a-long-random-value
# Generate with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password', method='pbkdf2:sha256'))"
# pbkdf2:sha256 is used explicitly (rather than werkzeug's scrypt default) since
# scrypt support depends on the OpenSSL build Python was compiled against, which
# is not guaranteed on shared hosting.
PASSWORD_HASH=pbkdf2:sha256:...

# Optional overrides (defaults shown):
# VAULT_DIR=./dev_vault
# DATABASE_PATH=./broot-kb.db
# SESSION_COOKIE_SECURE=1

# Local dev over plain http:// needs this, since browsers won't send Secure
# cookies back over a non-HTTPS origin. Never set this to 0 in production.
SESSION_COOKIE_SECURE=0
